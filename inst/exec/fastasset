#!/usr/bin/env Rscript

script_argument <- grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)
if (length(script_argument) == 1L) {
  launcher <- normalizePath(
    sub("^--file=", "", script_argument),
    mustWork = TRUE
  )
  package_library <- dirname(dirname(dirname(launcher)))
  .libPaths(unique(c(package_library, .libPaths())))
}

suppressPackageStartupMessages(library(fastASSETcli))

status <- tryCatch(
  {
    fastasset_cli_main(commandArgs(trailingOnly = TRUE))
    0L
  },
  error = function(error) {
    message("fastasset: ERROR: ", conditionMessage(error))
    2L
  }
)
quit(save = "no", status = status)
